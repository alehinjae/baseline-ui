{
  "name": "baseline-ui",
  "version": "0.4.0",
  "private": false,
  "description": "Design system do ecossistema — Base UI como motor de comportamento, tokens W3C como fonte única, manifest pronto para a ponte com o Figma.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "tokens",
    "baseline.manifest.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "tokens": "node scripts/build-tokens.mjs",
    "check-manifest": "node scripts/check-manifest.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "build": "npm run tokens && npm run check-contrast && npm run check-manifest && tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
